# Infrastructure Configuration
targetNode: "YOUR_WORKER_NODE_HERE"
replicaCount: 1

# OpenShift Registry
registry: "image-registry.openshift-image-registry.svc:5000"

# Secret Keys & Credentials
secrets:
  adminPass: "CHANGE_ME_ADMIN_PASS"
  flaskSecret: "CHANGE_ME_FLASK_SECRET"

dashboard:
  port: 5005

# Build/version metadata surfaced at /version and in the UI header.
# `version` is the semantic release string (bump on releases); `gitSha` and
# `buildTime` are overwritten on every deploy by deploy-helm.sh (--set), so the
# running pod is always traceable to the exact commit it was deployed from.
release:
  version: "1.8.0-beta"
  gitSha: "unknown"
  buildTime: "unknown"